# Token z uprawnieniem Editor - potrzebny TYLKO do jednorazowego `npm run seed`.
# https://www.sanity.io/manage/project/tbckptwx/api#tokens
SANITY_WRITE_TOKEN=

# Opcjonalnie: staly sekret do podpisywania URL-i og:image (inaczej zmienia sie co build).
# Wygeneruj: npx nuxt-og-image generate-secret  i ustaw tez w Vercel -> Environment Variables.
NUXT_OG_IMAGE_SECRET=
